# Copy to .env.local and fill in. Never commit .env.local.

# CRS sandbox credentials (server-side only)
CRS_USERNAME=
CRS_PASSWORD=
# Optional; defaults to https://api-sandbox.stitchcredit.com/api
# CRS_BASE_URL=

# Operator token the Python agents use to enroll themselves. Any long random string.
AGENTCIRCUIT_AGENT_TOKEN=

# uAgent identity seeds, one per agent. Any long random strings; keep them private.
CREDIT_AGENT_SEED_PHRASE=
FRAUD_AGENT_SEED_PHRASE=
# Payment agent
AGENT_SEED_PHRASE=

# AI planner. Gemini is used when a key is set, otherwise local Ollama.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# OLLAMA_MODEL=qwen3:1.7b

# Optional: lets visitors of a public tunnel (cloudflared) run the live demo.
# At least 8 characters. Without it, tunnel visitors see the recorded demo.
# AGENTCIRCUIT_DEMO_CODE=

# x402: a Base Sepolia address you control. Without it the paid API returns 503.
X402_PAY_TO=

# Only for scripts/x402-payment-agent.mjs --pay (real testnet settlement).
# Use a dedicated test wallet with no real funds.
# X402_ENABLE_TESTNET_PAYMENT=YES
# X402_BUYER_PRIVATE_KEY=

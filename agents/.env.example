# Copy to .env, or run `python init_env.py` to generate seeds and addresses automatically.
# Never commit .env. Quote values that contain '#'.

# Agent identity seeds (any long random string; the seed determines the agent address).
LEAD_AGENT_SEED=
CREDIT_AGENT_SEED=

# Addresses of the two agents (agent1q...). init_env.py derives them from the seeds.
LEAD_AGENT_ADDRESS=
CREDIT_AGENT_ADDRESS=

# Ports
LEAD_PORT=8001
CREDIT_PORT=8002

# Lead agent: true = local agent + Agentverse Mailbox (needed for ASI:One), false = local test only.
LEAD_MAILBOX=true
# Seconds the lead waits for the credit agent before telling the user it timed out.
LEAD_TASK_TIMEOUT_S=45

# Where the Next.js app (which owns the CRS credentials) is running.
CRS_GATEWAY_URL=http://127.0.0.1:3000
# Seconds to wait for one bureau lookup through the gateway.
CRS_GATEWAY_TIMEOUT_S=20

.mcp.json
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# personal / sponsor-portal notes (contain account info)
CRSportal.md
CRShompage.md
.claude/

# Fetch.ai uAgents identity and wallet private keys (created by uagents in the working directory)
private_keys.json

# python
.venv/
.venv-*/
__pycache__/
.pytest_cache/

# Local development AI provider selection
.agentcircuit-ai-provider.json

# logs and local editor/doc copies
*.log
.vscode/
fetchdocs/

# patch bundles and backup copies
*.zip
*.bak
*.backup
*_backup.txt
fetch_agents/*_backup.py
fetch_agents/*_before_*.py
